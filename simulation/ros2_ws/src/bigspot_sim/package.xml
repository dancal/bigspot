<?xml version="1.0"?>
<package format="3">
  <name>bigspot_sim</name><version>0.1.0</version>
  <description>BigSpot simulation adapter for Isaac ROS 5.0 and ROS 2 Lyrical.</description>
  <maintainer email="noreply@example.com">BigSpot maintainers</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>python3-numpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend><exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend><exec_depend>rosgraph_msgs</exec_depend><exec_depend>joy</exec_depend>
  <exec_depend>std_srvs</exec_depend><exec_depend>ament_index_python</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>rclcpp_components</exec_depend><exec_depend>isaac_ros_apriltag</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
